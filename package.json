{
  "name": "@linkurious/eslint-config-ogma",
  "version": "3.0.0-beta",
  "description": "Shareable oxlint and oxfmt configs for code linting and formatting",
  "type": "module",
  "exports": {
    "./oxlint": "./.oxlintrc.json",
    "./oxlint.json": "./.oxlintrc.json",
    "./oxfmt": "./.oxfmtrc.json",
    "./oxfmt.json": "./.oxfmtrc.json"
  },
  "scripts": {
    "validate:exports": "node scripts/validate-exports.mjs",
    "postversion": "sync_versions",
    "test": "npm run validate:exports",
    "test:unit": "npm run test",
    "bump:patch": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "oxlint": "1.85.0",
    "oxfmt": "0.70.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".oxlintrc.json",
    ".oxfmtrc.json"
  ],
  "keywords": [
    "oxlint",
    "oxfmt",
    "linter",
    "formatter",
    "code-quality"
  ],
  "author": "Linkurious SAS",
  "license": "Apache-2.0",
  "devDependencies": {
    "@linkurious/code-tools": "0.2.0"
  }
}